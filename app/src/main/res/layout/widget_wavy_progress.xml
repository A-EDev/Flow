<?xml version="1.0" encoding="utf-8"?>
<!-- The flat bar underneath; over it, while playing, the scrolling wave inside a container sized to
     the played length. The wave is drawn at a fixed width and clipped, so its wavelength never
     stretches with the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="12dp">

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="false"
        android:max="1000"
        android:progressDrawable="@drawable/widget_wavy_progress" />

    <FrameLayout
        android:id="@+id/widget_progress_wave_clip"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:clipChildren="true">

        <ProgressBar
            android:id="@+id/widget_progress_wave"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="660dp"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/widget_wave_moving"
            android:indeterminateOnly="true" />
    </FrameLayout>
</FrameLayout>
