<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The YouTube visitor identity belongs to one install (#921). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="youtube_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="youtube_identity.xml" />
    </device-transfer>
</data-extraction-rules>
