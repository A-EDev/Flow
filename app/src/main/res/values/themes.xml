<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flow" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Enable edge-to-edge -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- The platform splash. Before Android 13 it follows the system night mode; from 13 on,
         SplashController picks one of the styles below so each launch matches the app theme
         and launcher icon the user chose. -->
    <style name="Theme.Flow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Flow</item>
    </style>

    <style name="Theme.Flow.Starting.Light">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
    </style>
    <style name="Theme.Flow.Starting.Light.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg_flow_play</item>
    </style>
    <style name="Theme.Flow.Starting.Light.Amoled">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_amoled_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Light.Monochrome">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_monochrome_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Light.Dynamic" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_dynamic_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_dynamic</item>
        <item name="postSplashScreenTheme">@style/Theme.Flow</item>
    </style>

    <style name="Theme.Flow.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
    </style>
    <style name="Theme.Flow.Starting.Dark.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg_flow_play</item>
    </style>
    <style name="Theme.Flow.Starting.Dark.Amoled">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_amoled_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Dark.Monochrome">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_monochrome_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Dark.Ghost">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_ghost_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Dark.Dynamic" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_dynamic_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_dynamic</item>
        <item name="postSplashScreenTheme">@style/Theme.Flow</item>
    </style>

    <style name="Theme.Flow.Starting.Black">
        <item name="windowSplashScreenBackground">@color/splash_background_black</item>
    </style>
    <style name="Theme.Flow.Starting.Black.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg_flow_play</item>
    </style>
    <style name="Theme.Flow.Starting.Black.Amoled">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_amoled_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Black.Monochrome">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_monochrome_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Black.Ghost">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_ghost_inset</item>
    </style>
    <style name="Theme.Flow.Starting.Black.Dynamic" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_dynamic_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_dynamic</item>
        <item name="postSplashScreenTheme">@style/Theme.Flow</item>
    </style>

    <!-- Expressive icons: their own art at logo size over the tone's window, like the Flow badge. -->
    <style name="Theme.Flow.Starting.Light.Expressive" />
    <style name="Theme.Flow.Starting.Light.Expressive.Scallop">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_scallop</item>
    </style>
    <style name="Theme.Flow.Starting.Light.Expressive.Segmented">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_segmented</item>
    </style>
    <style name="Theme.Flow.Starting.Light.Expressive.Play">
