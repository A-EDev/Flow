{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow.local/schemas/sponsor-feedback-v1.json",
  "title": "Flow sponsor detection feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "created_at_epoch_ms",
    "video_id",
    "model",
    "transcript",
    "prediction",
    "feedback"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "sample_id": { "type": "string", "minLength": 1 },
    "created_at_epoch_ms": { "type": "integer", "minimum": 0 },
    "video_id": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_tag", "source", "is_auto_generated", "cues"],
      "properties": {
        "language_tag": { "type": "string", "minLength": 1 },
        "source": {
          "enum": ["youtube", "offline_caption", "unknown"]
        },
        "is_auto_generated": { "type": "boolean" },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cue" }
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spans"],
      "properties": {
        "inference_ms": { "type": "integer", "minimum": 0 },
        "spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/predicted_span" }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "corrected_spans"],
      "properties": {
        "verdict": {
          "enum": ["accepted", "rejected", "corrected", "missed"]
        },
        "corrected_spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/span" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "feedback": {
            "properties": {
              "verdict": { "enum": ["corrected", "missed"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "feedback": {
            "properties": {
              "corrected_spans": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "text"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "predicted_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "confidence"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
